DATABASE_URL="postgresql://user:password@localhost:5432/bank_dev?schema=public"

# Auth
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_ACCESS_TOKEN_TTL="900"
AUTH_REFRESH_TOKEN_TTL="2592000"

# Encryption at rest (card numbers, CVVs) — 32-byte key, base64-encoded
ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

NODE_ENV="development"

# Public base URL, used for absolute links in metadata (OpenGraph, sitemap, robots.txt)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Resend, https://resend.com) ---
# Create a SEND-ONLY API key. Without it, one-time codes and reset links are not e-mailed
# (in development they are printed in the server log instead; in production they cannot be delivered).
RESEND_API_KEY=
# Until you verify a domain, only onboarding@resend.dev works and it can only e-mail the Resend account owner.
EMAIL_FROM="Meridian Bank <onboarding@resend.dev>"

# Number of reverse proxies in front of the app. 0 = trust no forwarding headers (local dev).
# Set 1 behind a single proxy/CDN such as Render, Vercel or nginx.
TRUSTED_PROXY_HOPS=0
